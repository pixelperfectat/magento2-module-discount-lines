<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="pp_discount_line" resource="sales" engine="innodb" comment="PixelPerfect Discount Lines">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order Id"/>
        <column xsi:type="int" name="order_item_id" unsigned="true" nullable="true" comment="Order Item Id, null for order-level lines"/>
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="true" comment="Sales Rule Id"/>
        <column xsi:type="varchar" name="kind" nullable="false" length="32" comment="Line Kind"/>
        <column xsi:type="varchar" name="code" nullable="true" length="255" comment="Coupon / Gift Card Code"/>
        <column xsi:type="varchar" name="label" nullable="false" length="255" comment="Label Snapshot"/>
        <column xsi:type="decimal" name="amount" scale="4" precision="20" nullable="false" default="0" comment="Amount"/>
        <column xsi:type="decimal" name="base_amount" scale="4" precision="20" nullable="false" default="0" comment="Base Amount"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PP_DISCOUNT_LINE_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="pp_discount_line" column="order_id" referenceTable="sales_order"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="PP_DISCOUNT_LINE_ORDER_ITEM_ID_SALES_ORDER_ITEM_ITEM_ID"
                    table="pp_discount_line" column="order_item_id" referenceTable="sales_order_item"
                    referenceColumn="item_id" onDelete="CASCADE"/>
        <index referenceId="PP_DISCOUNT_LINE_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
</schema>
