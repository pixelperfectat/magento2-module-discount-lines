<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_success">
        <observer name="pp_discount_lines_persist" instance="PixelPerfect\DiscountLines\Observer\PersistDiscountLines"/>
    </event>
    <event name="sales_quote_address_collect_totals_after">
        <observer name="pp_discount_lines_store"
                  instance="PixelPerfect\DiscountLines\Observer\StoreQuoteDiscountLines"/>
    </event>
</config>
